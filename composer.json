{
    "name": "tobento/service-view",
    "version": "2.0",
    "type": "library",
    "description": "A flexible PHP view system.",
    "keywords": [
        "tobento",
        "package",
        "php",
        "view",
        "template"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/service-macro": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "tobento/service-dir": "^2.0",
        "tobento/service-support": "^2.0",
        "tobento/service-tag": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "twig/twig": "^3.21"
    },    
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\View\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\View\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}